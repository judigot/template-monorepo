# Comma-separated list of origins allowed to call the API from a browser.
# Falls back to the local Vite/Next.js dev servers when unset.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Port used by the local development server (src/index.ts).
PORT=3000

# Enable Google authentication only after configuring all five values.
# For production, BETTER_AUTH_URL must be the public HTTPS origin of this API.
# Google Cloud OAuth authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
