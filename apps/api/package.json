{
  "name": "@bigbang/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "start:node": "node src/index.ts",
    "build": "tsc --noEmit && bun build src/vercel.ts --outfile api/index.js --target node --format esm --minify",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "clean": "rm -rf .turbo .vercel"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@bigbang/api-client": "workspace:*",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@bigbang/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "oxlint": "^1.80.0",
    "typescript": "~6.0.3"
  }
}
