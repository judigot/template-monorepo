{
  "name": "@monorepo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "auth:migrate": "npx --yes auth@1.7.25 migrate --config ./src/auth.ts",
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "start:node": "node src/index.ts",
    "build": "tsc --noEmit && bun build src/vercel.ts --outfile api/index.js --target node --format esm --minify",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "clean": "rm -rf .turbo .vercel"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.25",
    "@hono/node-server": "^2.1.1",
    "@monorepo/api-client": "workspace:*",
    "hono": "^4.13.5",
    "zod": "^4.5.4",
    "better-auth": "1.7.25",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@monorepo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.1",
    "oxlint": "^1.80.0",
    "typescript": "~6.0.3"
  }
}
