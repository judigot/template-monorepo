{
  "name": "@judigot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "start:node": "node src/index.ts",
    "build": "tsc --noEmit",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "clean": "rm -rf .turbo .vercel"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@judigot/api-client": "workspace:*",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@judigot/typescript-config": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.10.1",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  }
}
