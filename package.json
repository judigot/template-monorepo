{
  "name": "template-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:primary": "turbo run dev --filter=@judigot/api --filter=@judigot/vite",
    "dev:vite": "turbo run dev --filter=@judigot/vite",
    "dev:nextjs": "turbo run dev --filter=@judigot/nextjs",
    "dev:api": "turbo run dev --filter=@judigot/api",
    "build": "turbo run build",
    "build:vite": "turbo run build --filter=@judigot/vite",
    "build:nextjs": "turbo run build --filter=@judigot/nextjs",
    "build:api": "turbo run build --filter=@judigot/api",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && biome lint . && bun run lint:eslint",
    "lint:eslint": "eslint --max-warnings 0 .",
    "format": "biome check --write .",
    "format:check": "biome check --linter-enabled=false .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-no-type-assertion": "^1.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
