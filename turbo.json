{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local", "bunfig.toml"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["VITE_API_URL", "API_URL", "NEXT_PUBLIC_API_URL", "CORS_ORIGINS"]
    },
    "@bigbang/api#build": {
      "dependsOn": ["^build"],
      "outputs": ["api/index.js"],
      "env": ["CORS_ORIGINS", "PORT"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["CORS_ORIGINS"]
    },
    "test:e2e": {
      "cache": false,
      "env": ["CI", "CORS_ORIGINS", "API_URL", "VITE_API_URL"]
    },
    "typecheck": {},
    "lint": {},
    "clean": {
      "cache": false
    }
  }
}
